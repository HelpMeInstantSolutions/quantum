<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAbsentStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAbsentBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABSENT"
                    android:textColor="@color/danger_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/dot_red"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAbsentClassRoll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class 10-A • Roll: 104"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvAbsentFather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father: Satish Malik (+91-9812777666)"
                android:textColor="@color/primary_navy"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallAbsentee"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Call"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/success_green"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_phone_call"
            app:iconTint="@android:color/white"
            app:iconSize="16dp"
            android:paddingHorizontal="12dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
