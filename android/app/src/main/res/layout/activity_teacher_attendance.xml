<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Modern Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTeachAtt"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_gradient"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Class Daily Attendance"
        app:titleTextColor="@android:color/white"
        app:subtitle="Quantum Science Academy"
        app:subtitleTextColor="#94A3B8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAttClassHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class 10 - Section A"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark Present (P) or Absent (A)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkAllPresentApp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="All Present"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/accent_green" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbAttLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttendanceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitAttendanceApp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save &amp; Submit Attendance"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/primary_blue" />
    </LinearLayout>

</LinearLayout>
