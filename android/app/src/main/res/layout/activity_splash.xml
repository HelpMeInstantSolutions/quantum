<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_navy"
    android:gravity="center">

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/ic_qsa_logo" />

    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivSplashLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="QUANTUM SCIENCE ACADEMY"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSplashTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Bhiwani, Haryana"
        android:textColor="@color/accent_gold"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:indeterminateTint="@color/accent_gold" />

</RelativeLayout>
