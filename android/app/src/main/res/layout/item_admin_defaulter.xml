<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDefaulterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDefaulterClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(Class 10-A)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDefaulterFather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father: Satish Malik (+91-9812777666)"
                android:textColor="@color/primary_navy"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDefaulterDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due Since: 15 Oct 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvDefaulterAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹4,500"
                android:textColor="@color/danger_red"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/dot_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallDefaulter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:text="Call"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/success_green"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_phone_call"
                app:iconSize="12dp"
                app:iconTint="@android:color/white"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
