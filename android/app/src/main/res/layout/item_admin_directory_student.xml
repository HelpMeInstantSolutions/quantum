<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgDirAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_student_male"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDirStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDirStudentClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class 10 - Section A | Roll: 101"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvDirFatherContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Father: Ramesh Kumar (9812345678)"
                    android:textColor="@color/primary_navy"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDirBioBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bio: #3"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calendar_day_selected"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirEditBio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Assign Bio ID"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/primary_blue"
                app:strokeColor="@color/primary_blue"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_fingerprint"
                app:iconSize="14dp"
                app:iconTint="@color/primary_blue"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirCall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Call Parent"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/success_green"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_phone_call"
                app:iconSize="14dp"
                app:iconTint="@android:color/white"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
