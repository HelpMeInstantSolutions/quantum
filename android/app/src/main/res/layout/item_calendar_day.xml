<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayCellRoot"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="2dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/dayCircle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Indicators: School (Green), Tuition (Orange), Absent (Red) -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotSchool"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_green"
            android:visibility="gone" />

        <View
            android:id="@+id/dotTuition"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_orange"
            android:visibility="gone" />

        <View
            android:id="@+id/dotAbsent"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_red"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
