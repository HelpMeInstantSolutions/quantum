                    <small class="text-muted">Cricket, Badminton & Physical Training</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_class.jpg" alt="Smart Classroom" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
                <div class="p-3 text-center">
                    <h6 class="fw-bold mb-0">Interactive Smart Classroom</h6>
                    <small class="text-muted">Audio-Visual Digital Projectors & Lectures</small>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
