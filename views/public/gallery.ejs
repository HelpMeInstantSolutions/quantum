<%- include('../partials/header') %>

<div class="py-5 bg-light border-bottom">
    <div class="container text-center">
        <span class="section-badge">Life at Star Academy</span>
        <h1 class="fw-bold mt-2 text-dark">Campus & Activity Gallery</h1>
        <p class="text-muted mx-auto" style="max-width: 650px;">
            Moments of learning, sports competitions, celebrations, and academic triumphs.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_campus.jpg" alt="Campus Building" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
                <div class="p-3 text-center">
                    <h6 class="fw-bold mb-0">Star Academy Main Building</h6>
                    <small class="text-muted">Modern Infrastructure & Smart Classrooms</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_lab.jpg" alt="Science Laboratory" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
                <div class="p-3 text-center">
                    <h6 class="fw-bold mb-0">Senior Science Labs</h6>
                    <small class="text-muted">Physics & Chemistry Practical Experiments</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_topper.jpg" alt="Topper Ceremony" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
                <div class="p-3 text-center">
                    <h6 class="fw-bold mb-0">Annual Topper Ceremony</h6>
                    <small class="text-muted">Facilitation of Board Exam Merit Holders</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_library.jpg" alt="Library" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
                <div class="p-3 text-center">
                    <h6 class="fw-bold mb-0">Central Digital Library</h6>
                    <small class="text-muted">5,000+ Books and Quiet Reading Room</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="/images/gallery_sports.jpg" alt="Sports Complex" class="img-fluid" style="height: 240px; object-fit: cover;" onerror="this.src='/images/1789551671_6aaa643768381.png'">
