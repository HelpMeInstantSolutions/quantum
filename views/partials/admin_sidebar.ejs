<%
    const pathOnly = (currentUrl || '').split('?')[0];
    const isExamsActive = pathOnly.startsWith('/admin/results');
    const isStudentsActive = pathOnly.startsWith('/admin/students') || pathOnly.startsWith('/admin/promotion');
    const isAttendanceActive = pathOnly.startsWith('/admin/attendance');
    const isFeesActive = pathOnly.startsWith('/admin/fees') || pathOnly.startsWith('/admin/receipts') || pathOnly.startsWith('/admin/pending-fees');
%>
<aside class="admin-sidebar">
    <div class="sidebar-brand">
        <img src="<%= school.logo_url || '/images/logo.png' %>" alt="<%= school.school_name || 'Quantum Science Acadmey' %> Logo" style="height: 38px; width: 38px; object-fit: contain; border-radius: 6px; background: white; padding: 2px;">
        <div class="sidebar-brand-text">
            <span class="d-inline-block text-truncate" style="max-width: 150px;"><%= school.school_name || 'Quantum Science Acadmey' %></span>
            <small><%= school.institution_type || 'Academy' %> ERP Panel</small>
        </div>
    </div>

    <ul class="sidebar-menu">
        <li>
            <a href="/admin/dashboard" class="<%= pathOnly === '/admin/dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="sidebar-heading">STUDENT & ACADEMICS</li>

        <!-- 1. Students & Admissions Submenu -->
        <li class="sidebar-dropdown">
            <a href="#collapseStudents" role="button" data-bs-toggle="collapse" data-bs-target="#collapseStudents" class="sidebar-dropdown-toggle <%= isStudentsActive ? 'active-parent' : '' %>" aria-expanded="<%= isStudentsActive ? 'true' : 'false' %>">
                <i class="fa-solid fa-user-graduate"></i>
                <span>Students</span>
                <i class="fa-solid fa-chevron-down arrow-icon ms-auto"></i>
            </a>
            <div class="collapse <%= isStudentsActive ? 'show' : '' %>" id="collapseStudents">
                <ul class="sidebar-submenu">
                    <li>
                        <a href="/admin/students" class="<%= (pathOnly === '/admin/students' || (pathOnly.startsWith('/admin/students/') && pathOnly !== '/admin/students/add')) ? 'active' : '' %>">
                            <i class="fa-solid fa-users"></i>
                            <span>All Students</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/students/add" class="<%= pathOnly === '/admin/students/add' ? 'active' : '' %>">
                            <i class="fa-solid fa-user-plus"></i>
                            <span>New Admission</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/promotion" class="<%= pathOnly.startsWith('/admin/promotion') ? 'active' : '' %>">
                            <i class="fa-solid fa-angles-up"></i>
                            <span>Class Promotion</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- 2. Attendance Submenu -->
        <li class="sidebar-dropdown">
            <a href="#collapseAttendance" role="button" data-bs-toggle="collapse" data-bs-target="#collapseAttendance" class="sidebar-dropdown-toggle <%= isAttendanceActive ? 'active-parent' : '' %>" aria-expanded="<%= isAttendanceActive ? 'true' : 'false' %>">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Attendance</span>
                <i class="fa-solid fa-chevron-down arrow-icon ms-auto"></i>
            </a>
            <div class="collapse <%= isAttendanceActive ? 'show' : '' %>" id="collapseAttendance">
                <ul class="sidebar-submenu">
                    <li>
                        <a href="/admin/attendance" class="<%= pathOnly === '/admin/attendance' ? 'active' : '' %>">
                            <i class="fa-solid fa-clipboard-user"></i>
                            <span>Daily Attendance</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/attendance/report" class="<%= pathOnly.startsWith('/admin/attendance/report') ? 'active' : '' %>">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Monthly Register</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/biometric/logs" class="<%= pathOnly.startsWith('/admin/biometric') ? 'active' : '' %>">
                            <i class="fa-solid fa-fingerprint text-info"></i>
                            <span>Biometric Live Monitor</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- 3. Daily Homework (Direct Link) -->
        <li>
            <a href="/admin/homework" class="<%= pathOnly.startsWith('/admin/homework') ? 'active' : '' %>">
                <i class="fa-solid fa-book-open-reader"></i>
                <span>Daily Homework</span>
            </a>
        </li>

        <!-- 4. Exams & Results Submenu (Collapse Section) -->
        <li class="sidebar-dropdown">
            <a href="#collapseExams" role="button" data-bs-toggle="collapse" data-bs-target="#collapseExams" class="sidebar-dropdown-toggle <%= isExamsActive ? 'active-parent' : '' %>" aria-expanded="<%= isExamsActive ? 'true' : 'false' %>">
                <i class="fa-solid fa-square-poll-vertical"></i>
                <span>Exams & Results</span>
                <i class="fa-solid fa-chevron-down arrow-icon ms-auto"></i>
            </a>
            <div class="collapse <%= isExamsActive ? 'show' : '' %>" id="collapseExams">
                <ul class="sidebar-submenu">
                    <li>
                        <a href="/admin/results" class="<%= (pathOnly === '/admin/results' || (pathOnly.startsWith('/admin/results/') && !pathOnly.includes('marks-matrix'))) ? 'active' : '' %>">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Exams & Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/results/marks-matrix" class="<%= pathOnly.startsWith('/admin/results/marks-matrix') ? 'active' : '' %>">
                            <i class="fa-solid fa-table-cells"></i>
                            <span>Bulk Marks Matrix</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="sidebar-heading">FINANCE & BILLING</li>

        <!-- 5. Fee Management Submenu -->
        <li class="sidebar-dropdown">
            <a href="#collapseFees" role="button" data-bs-toggle="collapse" data-bs-target="#collapseFees" class="sidebar-dropdown-toggle <%= isFeesActive ? 'active-parent' : '' %>" aria-expanded="<%= isFeesActive ? 'true' : 'false' %>">
                <i class="fa-solid fa-wallet"></i>
                <span>Fee Management</span>
                <i class="fa-solid fa-chevron-down arrow-icon ms-auto"></i>
            </a>
            <div class="collapse <%= isFeesActive ? 'show' : '' %>" id="collapseFees">
                <ul class="sidebar-submenu">
                    <li>
                        <a href="/admin/fees" class="<%= pathOnly === '/admin/fees' ? 'active' : '' %>">
                            <i class="fa-solid fa-gauge"></i>
                            <span>Fee Overview</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/fees/collect" class="<%= pathOnly.startsWith('/admin/fees/collect') ? 'active' : '' %>">
                            <i class="fa-solid fa-cash-register"></i>
                            <span>Collect Fee</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/fees/structures" class="<%= pathOnly.startsWith('/admin/fees/structures') ? 'active' : '' %>">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Fee Structures</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/receipts" class="<%= pathOnly.startsWith('/admin/receipts') ? 'active' : '' %>">
                            <i class="fa-solid fa-receipt"></i>
                            <span>Fee Receipts</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/pending-fees" class="<%= pathOnly.startsWith('/admin/pending-fees') ? 'active' : '' %>">
                            <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                            <span>Pending Fees & Alert</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="sidebar-heading">COMMUNICATION & LOGISTICS</li>
        <li>
            <a href="/admin/notifications" class="<%= pathOnly.startsWith('/admin/notifications') ? 'active' : '' %>">
                <i class="fa-solid fa-bullhorn"></i>
                <span>Notifications & Alerts</span>
            </a>
        </li>
        <li>
            <a href="/admin/transport" class="<%= pathOnly.startsWith('/admin/transport') ? 'active' : '' %>">
                <i class="fa-solid fa-bus-school"></i>
                <span>Bus Transport</span>
            </a>
        </li>

        <li class="sidebar-heading">ADMINISTRATION & CONFIG</li>
        <li>
            <a href="/admin/teachers" class="<%= pathOnly.startsWith('/admin/teachers') ? 'active' : '' %>">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>Teachers & Staff</span>
            </a>
        </li>
        <li>
            <a href="/admin/classes" class="<%= pathOnly.startsWith('/admin/classes') ? 'active' : '' %>">
                <i class="fa-solid fa-school"></i>
                <span>Classes & Subjects</span>
            </a>
        </li>
        <li>
            <a href="/admin/settings" class="<%= pathOnly.startsWith('/admin/settings') ? 'active' : '' %>">
                <i class="fa-solid fa-sliders text-warning"></i>
                <span>Site Configuration</span>
            </a>
        </li>

        <li class="mt-4 mb-2">
            <a href="/" target="_blank" class="text-info">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span>View Public Website</span>
            </a>
        </li>
        <li>
            <a href="/admin/logout" class="text-danger">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Log Out</span>
            </a>
        </li>
    </ul>
</aside>
