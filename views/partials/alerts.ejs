<% if (typeof flash !== 'undefined' && flash && flash.success) { %>
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div><strong>Success:</strong> <%= flash.success %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof flash !== 'undefined' && flash && flash.warning) { %>
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <div><strong>Notice:</strong> <%= flash.warning %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof flash !== 'undefined' && flash && flash.error) { %>
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation fs-5"></i>
        <div><strong>Error:</strong> <%= flash.error %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof flash !== 'undefined' && flash && flash.info) { %>
    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-info fs-5"></i>
        <div><strong>Info:</strong> <%= flash.info %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
