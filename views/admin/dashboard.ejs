<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../partials/alerts') %>

                <!-- Page Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Administrative Overview</h4>
                        <p class="text-muted small mb-0">Welcome back, <%= adminUser.name %>. Academic session <strong><%= school.current_session || '2026-2027' %></strong>.</p>
                    </div>
                    <div class="d-flex gap-2 mt-3 mt-sm-0">
                        <a href="/admin/students/add" class="btn btn-primary btn-sm fw-semibold">
                            <i class="fa-solid fa-user-plus me-1"></i> New Admission
                        </a>
                        <a href="/admin/attendance" class="btn btn-outline-primary btn-sm fw-semibold">
                            <i class="fa-solid fa-clipboard-user me-1"></i> Mark Attendance
                        </a>
                        <a href="/admin/fees/collect" class="btn btn-success btn-sm fw-semibold">
                            <i class="fa-solid fa-receipt me-1"></i> Collect Fee
                        </a>
                    </div>
                </div>

                <!-- KPI Widgets Row -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-widget">
                            <div class="stat-icon bg-primary-subtle text-primary">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <div>
                                <div class="stat-val"><%= stats.totalStudents %></div>
                                <div class="stat-label">Active Students</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-widget">
                            <div class="stat-icon bg-success-subtle text-success">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </div>
                            <div>
                                <div class="stat-val"><%= stats.attPercentage %>%</div>
                                <div class="stat-label">Today's Attendance (<%= stats.presentToday %> Present / <%= stats.absentToday %> Absent)</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-widget">
                            <div class="stat-icon bg-info-subtle text-info">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </div>
                            <div>
                                <div class="stat-val">₹<%= stats.totalCollected %></div>
                                <div class="stat-label">Fees Collected (Session)</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-widget">
                            <div class="stat-icon bg-danger-subtle text-danger">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <div>
                                <div class="stat-val">₹<%= stats.totalPending %></div>
                                <div class="stat-label">Pending / Overdue Fees</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Shortcut Banner -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3 shadow-sm">
                            <div class="p-3 rounded-circle bg-warning-subtle text-warning fs-4"><i class="fa-solid fa-bell"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1">Send Absent Alerts</h6>
                                <p class="text-muted small mb-1">Notify parents of absent students today via mobile notification.</p>
                                <a href="/admin/attendance" class="small fw-bold text-primary text-decoration-none">Trigger Alerts &rarr;</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3 shadow-sm">
                            <div class="p-3 rounded-circle bg-danger-subtle text-danger fs-4"><i class="fa-solid fa-envelope-open-dollar"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1">Fee Reminder Alert</h6>
                                <p class="text-muted small mb-1">1-Click broadcast payment reminders to all overdue parents.</p>
                                <a href="/admin/pending-fees" class="small fw-bold text-danger text-decoration-none">Send Reminders &rarr;</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3 shadow-sm">
                            <div class="p-3 rounded-circle bg-primary-subtle text-primary fs-4"><i class="fa-solid fa-table-cells"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1">Bulk Marks Matrix</h6>
                                <p class="text-muted small mb-1">Fast spreadsheet entry for Unit Tests, Term & Half Yearly exams.</p>
                                <a href="/admin/results/marks-matrix" class="small fw-bold text-primary text-decoration-none">Enter Marks &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tables Row -->
                <div class="row g-4">
                    <!-- Recent Fee Receipts -->
                    <div class="col-lg-7">
                        <div class="admin-card">
                            <div class="admin-card-header">
                                <h5><i class="fa-solid fa-receipt text-primary me-2"></i>Recent Fee Payments</h5>
                                <a href="/admin/receipts" class="btn btn-sm btn-outline-secondary">View Register</a>
                            </div>
                            <div class="table-responsive">
                                <table class="admin-table">
                                    <thead>
                                        <tr>
                                            <th>Receipt No</th>
                                            <th>Student</th>
                                            <th>Class</th>
                                            <th>Amount</th>
                                            <th>Mode</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (recentReceipts && recentReceipts.length > 0) { %>
                                            <% recentReceipts.forEach(r => { %>
                                                <tr>
                                                    <td><strong class="text-primary"><%= r.receipt_no %></strong></td>
                                                    <td><%= r.first_name %> <%= r.last_name %></td>
                                                    <td><span class="badge bg-light text-dark border"><%= r.class_name %>-<%= r.section_name %></span></td>
                                                    <td><strong>₹<%= Number(r.amount_paid).toLocaleString('en-IN') %></strong></td>
                                                    <td><span class="badge bg-secondary-subtle text-dark"><%= r.payment_mode %></span></td>
                                                    <td>
                                                        <a href="/admin/receipts/<%= r.id %>/print" target="_blank" class="btn btn-sm btn-light border py-0 px-2" title="Print Slip">
                                                            <i class="fa-solid fa-print"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">No payments recorded yet.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Circulars & Notices -->
                    <div class="col-lg-5">
                        <div class="admin-card">
                            <div class="admin-card-header">
                                <h5><i class="fa-solid fa-bullhorn text-warning me-2"></i>Active Circulars</h5>
                                <a href="/admin/notifications/create" class="btn btn-sm btn-primary">+ Post Notice</a>
                            </div>
                            <div class="admin-card-body p-0">
                                <ul class="list-group list-group-flush">
                                    <% if (recentNotices && recentNotices.length > 0) { %>
                                        <% recentNotices.forEach(n => { %>
                                            <li class="list-group-item p-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge <%= n.category === 'holiday' ? 'bg-danger' : 'bg-primary' %> text-uppercase" style="font-size: 0.7rem;">
                                                        <%= n.category.replace('_', ' ') %>
                                                    </span>
                                                    <small class="text-muted"><%= new Date(n.created_at).toLocaleDateString('en-IN') %></small>
                                                </div>
                                                <div class="fw-bold small text-dark"><%= n.title %></div>
                                                <p class="text-muted small mb-0 text-truncate"><%= n.message %></p>
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <li class="list-group-item text-center text-muted py-4">No active notices.</li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
