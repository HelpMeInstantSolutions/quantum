<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Bus Transport Passengers & Allocations</h4>
                        <p class="text-muted small mb-0">List of students utilizing school bus facilities.</p>
                    </div>
                    <a href="/admin/transport" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i> Fleet & Routes
                    </a>
                </div>

                <div class="admin-card">
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Adm No</th>
                                    <th>Roll</th>
                                    <th>Student Name</th>
                                    <th>Class & Sec</th>
                                    <th>Parent Contact</th>
                                    <th>Assigned Route</th>
                                    <th>Vehicle</th>
                                    <th>Driver Contact</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(st => { %>
                                        <tr>
                                            <td><span class="badge bg-light text-primary border"><%= st.admission_no %></span></td>
                                            <td><strong><%= st.roll_no %></strong></td>
                                            <td><strong><%= st.first_name %> <%= st.last_name %></strong></td>
                                            <td><span class="badge bg-secondary-subtle text-dark"><%= st.class_name %>-<%= st.section_name %></span></td>
                                            <td><small class="text-muted"><%= st.father_name %> (<%= st.father_phone %>)</small></td>
                                            <td><strong class="text-dark"><%= st.route_name %></strong></td>
                                            <td><span class="badge bg-warning-subtle text-dark border"><%= st.vehicle_number %></span></td>
                                            <td>
                                                <small><%= st.driver_name %> - <a href="tel:<%= st.driver_phone %>"><%= st.driver_phone %></a></small>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="8" class="text-center text-muted py-5">No students assigned to school bus transport yet.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
