<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Rubik', sans-serif;
            color: #0f172a;
        }
        .report-card-container {
            max-width: 800px;
            margin: 30px auto;
            background: #ffffff;
            border: 2px solid #0f172a;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border-radius: 8px;
            position: relative;
        }
        .school-header {
            text-align: center;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .school-logo {
            height: 60px;
            margin-bottom: 6px;
        }
        .marks-table th, .marks-table td {
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            font-size: 0.9rem;
        }
        .marks-table th {
            background-color: #f1f5f9;
        }
        @media print {
            body { background: white; margin: 0; }
            .report-card-container { box-shadow: none; border: 1px solid black; margin: 0; width: 100%; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>

    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary px-3 py-2 ms-2">
            Close
        </button>
    </div>

    <div class="report-card-container">
        <!-- School Header -->
        <div class="school-header">
            <img src="<%= school.logo_url || '/images/logo.png' %>" alt="Logo" class="school-logo" style="height: <%= school.logo_height ? Math.min(school.logo_height, 70) : 60 %>px; object-fit: contain;">
            <h2 class="fw-bold mb-0" style="color: #142b3c;"><%= school.school_name || 'Quantum Science Acadmey' %></h2>
            <div class="small text-muted"><%= school.address || 'Kaunt Road, Opposite Hanuman Mandir Bhiwani' %> | Tel: <%= school.phone || '+91-9466255941' %></div>
            <div class="badge bg-warning text-dark mt-2 fw-bold text-uppercase px-3 py-1">
                Official Student Academic Assessment Report Card
            </div>
        </div>

        <!-- Student Meta -->
        <div class="row g-2 mb-4 bg-light p-3 rounded-2 border">
            <div class="col-6"><strong>Student Name:</strong> <%= student.first_name %> <%= student.last_name %></div>
            <div class="col-6"><strong>Admission No:</strong> <%= student.admission_no %></div>
            <div class="col-6"><strong>Class & Section:</strong> <%= student.class_name %> - Section <%= student.section_name %></div>
            <div class="col-6"><strong>Roll Number:</strong> <%= student.roll_no || 'N/A' %></div>
            <div class="col-6"><strong>Father's Name:</strong> <%= student.father_name %></div>
            <div class="col-6"><strong>Assessment:</strong> <%= examName %></div>
        </div>

        <!-- Marks Breakdown Table -->
        <table class="table marks-table mb-4">
            <thead>
                <tr>
                    <th style="width: 50px;">S.No</th>
                    <th>Subject Name</th>
                    <th>Subject Code</th>
                    <th class="text-center">Max Marks</th>
                    <th class="text-center">Pass Marks</th>
                    <th class="text-center">Marks Scored</th>
                    <th class="text-center">Grade</th>
                </tr>
            </thead>
            <tbody>
                <% if (marksList && marksList.length > 0) { %>
                    <% marksList.forEach((m, idx) => { %>
                        <tr>
                            <td><%= idx + 1 %></td>
                            <td><strong><%= m.subject_name %></strong></td>
                            <td><small class="text-muted"><%= m.subject_code || '-' %></small></td>
                            <td class="text-center"><%= m.max_marks %></td>
                            <td class="text-center"><%= m.pass_marks %></td>
                            <td class="text-center">
                                <% if (m.is_absent) { %>
                                    <span class="text-danger fw-bold">ABSENT</span>
                                <% } else { %>
                                    <strong><%= m.marks_obtained %></strong>
                                <% } %>
                            </td>
                            <td class="text-center"><strong><%= m.grade %></strong></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="text-center py-3 text-muted">No assessment scores recorded.</td></tr>
                <% } %>
            </tbody>
            <tfoot>
                <tr class="table-secondary fw-bold">
                    <td colspan="3" class="text-end">GRAND TOTAL:</td>
                    <td class="text-center"><%= totalMax %></td>
                    <td></td>
                    <td class="text-center text-primary fs-6"><%= totalObtained %></td>
                    <td class="text-center fs-6"><%= overallGrade %></td>
                </tr>
            </tfoot>
        </table>

        <!-- Result Summary -->
        <div class="row align-items-center mb-5 p-3 rounded-2" style="background-color: #eff6ff; border: 1px solid #bfdbfe;">
            <div class="col-4 text-center border-end">
                <small class="text-muted d-block">Overall Percentage</small>
                <h4 class="fw-bold text-primary mb-0"><%= overallPercentage %>%</h4>
            </div>
            <div class="col-4 text-center border-end">
                <small class="text-muted d-block">Overall Grade</small>
                <h4 class="fw-bold text-success mb-0"><%= overallGrade %></h4>
            </div>
            <div class="col-4 text-center">
                <small class="text-muted d-block">Final Assessment Result</small>
                <h4 class="fw-bold <%= overallPercentage >= 33 ? 'text-success' : 'text-danger' %> mb-0">
                    <%= overallPercentage >= 33 ? 'QUALIFIED / PASSED' : 'NEEDS IMPROVEMENT' %>
                </h4>
            </div>
        </div>

        <!-- Signatures -->
        <div class="row pt-4 mt-5 text-center">
            <div class="col-4">
                <hr style="border-top: 1px dashed black;">
                <small class="fw-bold">Class Teacher Signature</small>
            </div>
            <div class="col-4">
                <hr style="border-top: 1px dashed black;">
                <small class="fw-bold">Exam Coordinator</small>
            </div>
            <div class="col-4">
                <hr style="border-top: 1px dashed black;">
                <small class="fw-bold">Principal / Director Seal</small>
            </div>
        </div>
    </div>

</body>
</html>
