<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Exams & Assessment Results</h4>
                        <p class="text-muted small mb-0">Manage Single Class Tests, Unit Tests, Half-Yearly, and Board Mock examinations.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/admin/results/marks-matrix" class="btn btn-success fw-bold">
                            <i class="fa-solid fa-table-cells me-1"></i> Bulk Marks Entry Matrix
                        </a>
                        <a href="/admin/results/exams/create" class="btn btn-primary fw-bold">
                            <i class="fa-solid fa-plus me-1"></i> Create Exam / Test
                        </a>
                    </div>
                </div>

                <!-- Exams List Table -->
                <div class="admin-card">
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Exam Title</th>
                                    <th>Exam Type</th>
                                    <th>Class</th>
                                    <th>Academic Session</th>
                                    <th>Subjects</th>
                                    <th>Scores Entered</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (exams && exams.length > 0) { %>
                                    <% exams.forEach(ex => { %>
                                        <tr>
                                            <td>
                                                <h6 class="fw-bold text-dark mb-0"><%= ex.exam_name %></h6>
                                                <small class="text-muted">Start: <%= ex.start_date ? new Date(ex.start_date).toLocaleDateString('en-IN') : 'TBD' %></small>
                                            </td>
                                            <td>
                                                <span class="badge <%= ex.exam_type === 'single_test' ? 'bg-secondary' : (ex.exam_type === 'unit_test' ? 'bg-info text-dark' : 'bg-primary') %> text-uppercase">
                                                    <%= ex.exam_type.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td><span class="badge bg-light text-dark border"><%= ex.class_name %></span></td>
                                            <td><%= ex.session_year %></td>
                                            <td><span class="badge bg-primary-subtle text-primary border"><%= ex.subjects_count %> Subjects</span></td>
                                            <td><strong class="text-success"><%= ex.marks_entered_count %> Entries</strong></td>
                                            <td><span class="badge bg-success-subtle text-success border">Published</span></td>
                                            <td class="text-end">
                                                <a href="/admin/results/marks-matrix?exam_id=<%= ex.id %>" class="btn btn-sm btn-primary fw-bold" title="Enter Marks">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i> Marks Matrix
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="8" class="text-center text-muted py-5">No exams created yet. Click "Create Exam / Test" above.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
