<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Create New Examination or Test</h4>
                        <p class="text-muted small mb-0">Single Class Test, Unit Test, Term Exam, Half Yearly, or Annual Board Mock.</p>
                    </div>
                    <a href="/admin/results" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Exams
                    </a>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="admin-card">
                            <div class="admin-card-header">
                                <h5><i class="fa-solid fa-file-circle-check text-primary me-2"></i>Exam Setup Details</h5>
                            </div>
                            <div class="admin-card-body">
                                <form action="/admin/results/exams/create" method="POST">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-8">
                                            <label class="form-label small fw-bold">Exam / Test Name *</label>
                                            <input type="text" name="exam_name" class="form-control" required placeholder="e.g. Unit Test 2 (Physics & Math) or Half Yearly Exam 2026">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Exam Type *</label>
                                            <select name="exam_type" class="form-select" required>
                                                <option value="single_test">Single Chapter / Class Test</option>
                                                <option value="unit_test" selected>Unit Test</option>
                                                <option value="term">Term Exam</option>
                                                <option value="half_yearly">Half Yearly Examination</option>
                                                <option value="annual">Annual Final Examination</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Select Class *</label>
                                            <select name="class_id" class="form-select" required>
                                                <% classes.forEach(c => { %>
                                                    <option value="<%= c.id %>"><%= c.class_name %></option>
                                                <% }) %>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Academic Session</label>
                                            <input type="text" name="session_year" class="form-control" value="2026-2027">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Start Date</label>
                                            <input type="date" name="start_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">End Date</label>
                                            <input type="date" name="end_date" class="form-control" value="<%= new Date(Date.now() + 86400000 * 7).toISOString().split('T')[0] %>">
                                        </div>
                                    </div>

                                    <div class="p-3 bg-light rounded-3 mb-4">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <i class="fa-solid fa-wand-magic-sparkles text-primary"></i>
                                            <strong class="small text-dark">Automated Subject Scheduling</strong>
                                        </div>
                                        <p class="text-muted small mb-0">
                                            When created, all subjects of the selected class will be auto-scheduled with default 50 marks. Teachers can immediately open the <strong>Bulk Marks Matrix</strong> and type student marks in seconds!
                                        </p>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/admin/results" class="btn btn-light border">Cancel</a>
                                        <button type="submit" class="btn btn-primary fw-bold px-4">
                                            <i class="fa-solid fa-arrow-right me-1"></i> Create Exam & Open Marks Matrix
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
