<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .matrix-table input:focus {
            background-color: #fef08a !important; /* highlight active cell in yellow */
        }
    </style>
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="fa-solid fa-table-cells text-primary me-2"></i>Bulk Marks Entry Matrix</h4>
                        <p class="text-muted small mb-0">Fast keyboard spreadsheet entry (press <kbd>Enter</kbd> or <kbd>&darr;</kbd> to jump to next student). Auto-calculates grades!</p>
                    </div>
                    <div>
                        <a href="/admin/results" class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Exams
                        </a>
                    </div>
                </div>

                <!-- Exam & Subject Selector -->
                <div class="admin-card mb-4">
                    <div class="admin-card-body p-3">
                        <form method="GET" action="/admin/results/marks-matrix" class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted">1. Select Examination *</label>
                                <select name="exam_id" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <% exams.forEach(e => { %>
                                        <option value="<%= e.id %>" <%= exam_id == e.id ? 'selected' : '' %>><%= e.exam_name %> (<%= e.class_name %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted">2. Select Subject Paper *</label>
                                <select name="schedule_id" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <% if (schedules && schedules.length > 0) { %>
                                        <% schedules.forEach(s => { %>
                                            <option value="<%= s.id %>" <%= schedule_id == s.id ? 'selected' : '' %>>
                                                <%= s.subject_name %> (Max: <%= s.max_marks %> | Pass: <%= s.pass_marks %>)
                                            </option>
                                        <% }) %>
                                    <% } else { %>
                                        <option value="">No subjects scheduled</option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">Load Matrix</button>
                            </div>
                        </form>
                    </div>
                </div>

                <% if (selectedSchedule && studentsWithMarks && studentsWithMarks.length > 0) { %>
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 bg-white rounded-3 border shadow-sm">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <span class="fw-bold fs-5 text-dark"><%= selectedSchedule.subject_name %></span>
                                <small class="text-muted d-block">Exam: <%= selectedExam.exam_name %> (<%= selectedExam.class_name %>)</small>
                            </div>
                            <span class="badge bg-primary fs-6 px-3 py-2">Max Marks: <span id="maxMarksVal"><%= selectedSchedule.max_marks %></span></span>
                            <span class="badge bg-light text-dark border fs-6 px-3 py-2">Pass Marks: <%= selectedSchedule.pass_marks %></span>
                        </div>
                        <div class="text-muted small">
                            <i class="fa-solid fa-keyboard me-1 text-primary"></i> Tip: Use <kbd>Tab</kbd> or <kbd>&darr;</kbd> for rapid entry.
                        </div>
                    </div>

                    <!-- Spreadsheet Matrix Form -->
                    <form action="/admin/results/marks-matrix/save" method="POST" id="marksMatrixForm">
                        <input type="hidden" name="exam_id" value="<%= exam_id %>">
                        <input type="hidden" name="exam_schedule_id" value="<%= schedule_id %>">

                        <div class="admin-card">
                            <div class="table-responsive">
                                <table class="admin-table matrix-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 70px;">Roll</th>
                                            <th>Admission No</th>
                                            <th>Student Name</th>
                                            <th>Section</th>
                                            <th style="width: 130px;" class="text-center">Marks Obtained</th>
                                            <th style="width: 90px;" class="text-center">Absent?</th>
                                            <th style="width: 100px;" class="text-center">Auto Grade</th>
                                            <th>Remarks (Optional)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% studentsWithMarks.forEach((st, idx) => { %>
                                            <tr>
                                                <td><strong><%= st.roll_no || (idx + 1) %></strong></td>
                                                <td><small class="text-muted"><%= st.admission_no %></small></td>
                                                <td>
                                                    <a href="/admin/results/report-card/<%= st.student_id %>" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                        <%= st.first_name %> <%= st.last_name %>
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-light text-dark border"><%= st.section_name %></span></td>
                                                <td class="text-center">
                                                    <input type="number" 
                                                           step="0.5" 
                                                           min="0" 
                                                           max="<%= selectedSchedule.max_marks %>" 
                                                           name="marks[<%= st.student_id %>]" 
                                                           id="mark_<%= st.student_id %>" 
                                                           class="matrix-input marks-entry" 
                                                           data-student-id="<%= st.student_id %>"
                                                           value="<%= st.is_absent ? '' : (st.marks_obtained !== null ? st.marks_obtained : '') %>" 
                                                           placeholder="0"
                                                           <%= st.is_absent ? 'disabled' : '' %>
                                                           oninput="updateGrade('<%= st.student_id %>')">
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" 
                                                           class="form-check-input" 
                                                           name="is_absent[<%= st.student_id %>]" 
                                                           id="absent_<%= st.student_id %>" 
                                                           value="1" 
                                                           <%= st.is_absent ? 'checked' : '' %> 
                                                           onchange="toggleAbsent('<%= st.student_id %>')">
                                                </td>
                                                <td class="text-center">
                                                    <span class="grade-badge" id="grade_badge_<%= st.student_id %>">
                                                        <%= st.is_absent ? 'AB' : (st.grade || '-') %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <input type="text" 
                                                           name="remarks[<%= st.student_id %>]" 
                                                           class="form-control form-control-sm" 
                                                           placeholder="e.g. Good concept" 
                                                           value="<%= st.remarks || '' %>">
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <div class="admin-card-body border-top d-flex justify-content-between align-items-center bg-light">
                                <span class="text-muted small">All changes will be updated in the database and visible in the parent app immediately.</span>
                                <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Marks Matrix (1-Click)
                                </button>
                            </div>
                        </div>
                    </form>
                <% } else { %>
                    <div class="admin-card p-5 text-center text-muted">
                        <i class="fa-solid fa-file-pen fs-1 text-secondary mb-3"></i>
                        <h5>Please select an Exam and Subject Paper to open the Bulk Marks Matrix.</h5>
                    </div>
                <% } %>

            </main>
        </div>
    </div>

    <script>
        const maxMarks = parseFloat(document.getElementById('maxMarksVal')?.innerText || 100);

        function updateGrade(studentId) {
            const input = document.getElementById('mark_' + studentId);
            const badge = document.getElementById('grade_badge_' + studentId);
            const val = parseFloat(input.value);

            if (isNaN(val) || val < 0) {
                badge.innerText = '-';
                badge.style.background = '#e2e8f0';
                badge.style.color = '#1e293b';
                return;
            }

            const pct = (val / maxMarks) * 100;
            let grade = 'D';
            let color = '#ef4444';

            if (pct >= 90) { grade = 'A+'; color = '#15803d'; }
            else if (pct >= 80) { grade = 'A'; color = '#16a34a'; }
            else if (pct >= 70) { grade = 'B+'; color = '#2563eb'; }
            else if (pct >= 60) { grade = 'B'; color = '#3b82f6'; }
            else if (pct >= 50) { grade = 'C+'; color = '#d97706'; }
            else if (pct >= 33) { grade = 'C'; color = '#eab308'; }

            badge.innerText = grade;
            badge.style.background = '#dcfce7';
            badge.style.color = color;
        }

        function toggleAbsent(studentId) {
            const chk = document.getElementById('absent_' + studentId);
            const input = document.getElementById('mark_' + studentId);
            const badge = document.getElementById('grade_badge_' + studentId);

            if (chk.checked) {
                input.value = '';
                input.disabled = true;
                badge.innerText = 'AB';
                badge.style.background = '#fee2e2';
                badge.style.color = '#b91c1c';
            } else {
                input.disabled = false;
                updateGrade(studentId);
                input.focus();
            }
        }

        // Fast keyboard navigation: Down Arrow & Enter jump to next row
        document.addEventListener('keydown', function(e) {
            if ((e.key === 'Enter' || e.key === 'ArrowDown') && e.target.classList.contains('marks-entry')) {
                e.preventDefault();
                const inputs = Array.from(document.querySelectorAll('.marks-entry:not([disabled])'));
                const currentIndex = inputs.indexOf(e.target);
                if (currentIndex >= 0 && currentIndex < inputs.length - 1) {
                    inputs[currentIndex + 1].focus();
                    inputs[currentIndex + 1].select();
                }
            } else if (e.key === 'ArrowUp' && e.target.classList.contains('marks-entry')) {
                e.preventDefault();
                const inputs = Array.from(document.querySelectorAll('.marks-entry:not([disabled])'));
                const currentIndex = inputs.indexOf(e.target);
                if (currentIndex > 0) {
                    inputs[currentIndex - 1].focus();
                    inputs[currentIndex - 1].select();
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
