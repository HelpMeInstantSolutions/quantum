<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Student Directory & Documents</h4>
                        <p class="text-muted small mb-0">Total <%= students.length %> active students enrolled across classes.</p>
                    </div>
                    <div>
                        <a href="/admin/students/add" class="btn btn-primary fw-semibold">
                            <i class="fa-solid fa-user-plus me-1"></i> New Admission
                        </a>
                    </div>
                </div>

                <!-- Filters Card -->
                <div class="admin-card mb-4">
                    <div class="admin-card-body p-3">
                        <form method="GET" action="/admin/students" class="row g-2 align-items-center">
                            <div class="col-md-3">
                                <label class="small text-muted fw-semibold">Filter by Class</label>
                                <select name="class_id" id="studentFilterClass" class="form-select form-select-sm">
                                    <option value="">All Classes</option>
                                    <% classes.forEach(c => { %>
                                        <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>><%= c.class_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted fw-semibold">Section</label>
                                <select name="section_id" id="studentFilterSection" class="form-select form-select-sm">
                                    <option value="">All</option>
                                    <% const availSections = filters.class_id ? sections.filter(s => s.class_id == filters.class_id) : []; %>
                                    <% availSections.forEach(s => { %>
                                        <option value="<%= s.id %>" <%= filters.section_id == s.id ? 'selected' : '' %>>Section <%= s.section_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted fw-semibold">Search by Name / Adm. No / SRN / PEN / Phone</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" name="search" class="form-control" placeholder="Search name, adm no, SRN, PEN..." value="<%= filters.search || '' %>">
                                    <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-search"></i></button>
                                </div>
                            </div>
                            <div class="col-md-3 d-flex gap-2 align-items-end pt-3">
                                <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-semibold">Apply Filter</button>
                                <a href="/admin/students" class="btn btn-sm btn-outline-secondary">Reset</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Students Table -->
                <div class="admin-card">
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Adm. No</th>
                                    <th>Roll</th>
                                    <th>Student Name</th>
                                    <th>Class & Sec</th>
                                    <th>Father Name</th>
                                    <th>Mobile Contact</th>
                                    <th>Transport</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(st => { %>
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-primary border fw-bold"><%= st.admission_no %></span>
                                                <% if (st.biometric_id) { %>
                                                    <small class="d-block font-monospace mt-1" style="font-size: 0.72rem;" title="Biometric Machine User ID">
                                                        <span class="badge bg-primary text-white border-0 px-1"><i class="fa-solid fa-fingerprint me-1"></i>Bio ID: <%= st.biometric_id %></span>
                                                    </small>
                                                <% } else { %>
                                                    <small class="text-muted d-block mt-1" style="font-size: 0.7rem;" title="No Biometric ID Assigned Yet">
                                                        <span class="badge bg-light text-muted border px-1">Bio: Not Assigned</span>
                                                    </small>
                                                <% } %>
                                                <% if (st.srn_no) { %>
                                                    <small class="text-muted d-block font-monospace mt-1" style="font-size: 0.7rem;" title="Haryana MIS SRN"><span class="badge bg-warning-subtle text-dark border-0 p-0 px-1">SRN: <%= st.srn_no %></span></small>
                                                <% } %>
                                                <% if (st.pen_no) { %>
                                                    <small class="text-muted d-block font-monospace mt-1" style="font-size: 0.7rem;" title="UDISE+ PEN">PEN: <%= st.pen_no %></small>
                                                <% } %>
                                            </td>
                                            <td><strong><%= st.roll_no || '-' %></strong></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="<%= getAvatar(st.photo_url, st.gender, 'student') %>" class="rounded-circle border" style="width: 34px; height: 34px; object-fit: cover;">
                                                    <div>
                                                        <a href="/admin/students/<%= st.id %>" class="fw-bold text-dark text-decoration-none">
                                                            <%= st.first_name %> <%= st.last_name %>
                                                        </a>
                                                        <small class="text-muted d-block" style="font-size: 0.75rem;"><%= st.gender %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-primary-subtle text-primary border"><%= st.class_name %>-<%= st.section_name %></span></td>
                                            <td><%= st.father_name %></td>
                                            <td><a href="tel:<%= st.father_phone %>" class="text-muted text-decoration-none small"><i class="fa-solid fa-phone me-1 text-success"></i><%= st.father_phone %></a></td>
                                            <td>
                                                <% if (st.route_name) { %>
                                                    <span class="badge bg-info-subtle text-info border small" title="<%= st.route_name %>"><i class="fa-solid fa-bus me-1"></i>Bus Opted</span>
                                                <% } else { %>
                                                    <span class="text-muted small">Self</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border">Active</span>
                                            </td>
                                            <td class="text-end">
                                                <a href="/admin/students/<%= st.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" title="View 360 Profile & Documents">
                                                    <i class="fa-solid fa-id-card"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2" data-bs-toggle="modal" data-bs-target="#changePassStudentModal<%= st.id %>" title="Change Parent / Student App Password">
                                                    <i class="fa-solid fa-key"></i>
                                                </button>
                                                <a href="/admin/students/<%= st.id %>/edit" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edit">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <a href="/admin/fees/collect?student_id=<%= st.id %>" class="btn btn-sm btn-outline-success py-0 px-2" title="Collect Fee">
                                                    <i class="fa-solid fa-indian-rupee-sign"></i>
                                                </a>
                                            </td>
                                        </tr>

                                        <!-- MODAL: Change Password for this Student / Parent -->
                                        <div class="modal fade" id="changePassStudentModal<%= st.id %>" tabindex="-1">
                                            <div class="modal-dialog modal-sm">
                                                <div class="modal-content text-start">
                                                    <form action="/admin/students/<%= st.id %>/change-password" method="POST">
                                                        <div class="modal-header">
                                                            <h6 class="modal-title fw-bold"><i class="fa-solid fa-key text-warning me-2"></i>Parent App Password</h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-2">
                                                                <small class="text-muted d-block">Student:</small>
                                                                <strong class="text-dark"><%= st.first_name %> <%= st.last_name %></strong>
                                                                <span class="badge bg-light text-primary border ms-1"><%= st.admission_no %></span>
                                                            </div>
                                                            <div class="mb-3">
                                                                <small class="text-muted d-block">Father / Guardian:</small>
                                                                <span class="small text-dark fw-semibold"><%= st.father_name %> (<%= st.father_phone %>)</span>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold">New App Password *</label>
                                                                <input type="text" name="new_password" id="studentPassInput<%= st.id %>" class="form-control form-control-sm fw-bold" required minlength="4" value="student123">
                                                            </div>
                                                            <div class="d-flex gap-1 mb-2">
                                                                <button type="button" class="btn btn-xs btn-outline-secondary small" style="font-size: 0.72rem;" onclick="document.getElementById('studentPassInput<%= st.id %>').value='student123';">student123</button>
                                                                <button type="button" class="btn btn-xs btn-outline-secondary small" style="font-size: 0.72rem;" onclick="document.getElementById('studentPassInput<%= st.id %>').value='123456';">123456</button>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-warning fw-bold">Update Password</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">No students found matching your criteria.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script>
        const allSections = <%- JSON.stringify(sections) %>;
        const filterClass = document.getElementById('studentFilterClass');
        const filterSection = document.getElementById('studentFilterSection');

        if (filterClass && filterSection) {
            filterClass.addEventListener('change', function() {
                const classId = this.value;
                filterSection.innerHTML = '<option value="">All</option>';
                if (classId) {
                    const filtered = allSections.filter(s => String(s.class_id) === String(classId));
                    filtered.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = `Section ${s.section_name}`;
                        filterSection.appendChild(opt);
                    });
                }
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
