<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="fa-solid fa-angles-up text-primary me-2"></i>Class Promotion to Next Academic Session</h4>
                        <p class="text-muted small mb-0">Promote entire classes to the next standard or retain students at session end.</p>
                    </div>
                </div>

                <!-- Step 1: Promotion Mapping Selection -->
                <div class="admin-card mb-4">
                    <div class="admin-card-header bg-primary-subtle text-primary">
                        <h5 class="mb-0"><i class="fa-solid fa-arrows-split-up-and-left me-2"></i>Select Current and Target Class / Session</h5>
                    </div>
                    <div class="admin-card-body p-3">
                        <form method="GET" action="/admin/promotion" class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">From Current Class *</label>
                                <select name="from_class_id" class="form-select form-select-sm" required>
                                    <% classes.forEach(c => { %>
                                        <option value="<%= c.id %>" <%= from_class_id == c.id ? 'selected' : '' %>><%= c.class_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">From Session</label>
                                <input type="text" name="from_session" class="form-control form-control-sm" value="<%= from_session %>">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Promote To Target Class *</label>
                                <select name="to_class_id" class="form-select form-select-sm">
                                    <option value="">-- Choose Next Class --</option>
                                    <% classes.forEach(c => { %>
                                        <option value="<%= c.id %>" <%= to_class_id == c.id ? 'selected' : '' %>><%= c.class_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">To Next Session</label>
                                <input type="text" name="to_session" class="form-control form-control-sm" value="<%= to_session %>">
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary btn-sm fw-bold px-4">
                                    <i class="fa-solid fa-users-viewfinder me-1"></i> Load Students List
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <% if (students && students.length > 0) { %>
                    <form action="/admin/promotion/execute" method="POST" onsubmit="return confirm('Execute class promotion for selected students?');">
                        <input type="hidden" name="from_class_id" value="<%= from_class_id %>">
                        <input type="hidden" name="to_class_id" value="<%= to_class_id %>">
                        <input type="hidden" name="from_session" value="<%= from_session %>">
                        <input type="hidden" name="to_session" value="<%= to_session %>">

                        <div class="admin-card mb-4">
                            <div class="admin-card-header d-flex justify-content-between align-items-center">
                                <h5>Student Promotion Roster (<%= students.length %> Students)</h5>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setAllActions('promote')">Set All: Promote</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setAllActions('retain')">Set All: Retain</button>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="admin-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 40px;">
                                                <input type="checkbox" id="selectAllChk" class="form-check-input" checked onclick="toggleAllCheckboxes(this)">
                                            </th>
                                            <th>Roll</th>
                                            <th>Admission No</th>
                                            <th>Student Full Name</th>
                                            <th>Section</th>
                                            <th>Father Name</th>
                                            <th style="width: 250px;">Promotion Decision</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% students.forEach(st => { %>
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="selected_students" value="<%= st.id %>" class="form-check-input promo-chk" checked>
                                                </td>
                                                <td><strong><%= st.roll_no || '-' %></strong></td>
                                                <td><small class="text-muted"><%= st.admission_no %></small></td>
                                                <td>
                                                    <strong><%= st.first_name %> <%= st.last_name %></strong>
                                                </td>
                                                <td><span class="badge bg-light text-dark border"><%= st.section_name %></span></td>
                                                <td><small class="text-muted"><%= st.father_name %></small></td>
                                                <td>
                                                    <select name="student_action[<%= st.id %>]" class="form-select form-select-sm promo-action-select">
                                                        <option value="promote" selected>Promote to Next Class</option>
                                                        <option value="retain">Retain in Same Class</option>
                                                        <option value="graduate">Mark Graduated / Passed Out</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <div class="admin-card-body border-top d-flex justify-content-end bg-light">
                                <button type="submit" class="btn btn-success fw-bold px-4 shadow">
                                    <i class="fa-solid fa-angles-up me-1"></i> Execute Class Promotion (1-Click)
                                </button>
                            </div>
                        </div>
                    </form>
                <% } else { %>
                    <div class="admin-card p-4 text-center text-muted mb-4">
                        <p class="mb-0">Please select a class to load students for promotion.</p>
                    </div>
                <% } %>

                <!-- Historical Promotion Audit Log -->
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h5>Recent Promotion History & Audit Log</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>From Class</th>
                                    <th>To Class</th>
                                    <th>Sessions</th>
                                    <th>Decision</th>
                                    <th>Promoted At</th>
                                    <th>Admin</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (promotionLogs && promotionLogs.length > 0) { %>
                                    <% promotionLogs.forEach(pl => { %>
                                        <tr>
                                            <td><strong><%= pl.first_name %> <%= pl.last_name %></strong> (<%= pl.admission_no %>)</td>
                                            <td><%= pl.from_class_name %></td>
                                            <td><%= pl.to_class_name || 'Graduated' %></td>
                                            <td><small class="text-muted"><%= pl.from_session %> &rarr; <%= pl.to_session %></small></td>
                                            <td>
                                                <span class="badge <%= pl.action === 'promoted' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark' %> text-capitalize">
                                                    <%= pl.action %>
                                                </span>
                                            </td>
                                            <td><small class="text-muted"><%= new Date(pl.promoted_at).toLocaleDateString('en-IN') %></small></td>
                                            <td><small class="text-muted"><%= pl.admin_name || 'Admin' %></small></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="7" class="text-center text-muted py-3">No historical promotions logged yet.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script>
        function toggleAllCheckboxes(master) {
            document.querySelectorAll('.promo-chk').forEach(c => c.checked = master.checked);
        }
        function setAllActions(action) {
            document.querySelectorAll('.promo-action-select').forEach(s => s.value = action);
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
