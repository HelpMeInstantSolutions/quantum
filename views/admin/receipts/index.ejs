<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Fee Receipts Archive & Register</h4>
                        <p class="text-muted small mb-0">Search, view, and reprint official school fee payment slips.</p>
                    </div>
                    <div>
                        <a href="/admin/fees/collect" class="btn btn-success fw-bold">
                            <i class="fa-solid fa-cash-register me-1"></i> Collect New Fee
                        </a>
                    </div>
                </div>

                <!-- Filters -->
                <div class="admin-card mb-4">
                    <div class="admin-card-body p-3">
                        <form method="GET" action="/admin/receipts" class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="small text-muted fw-semibold">Search by Receipt No / Student Name / Adm No</label>
                                <input type="text" name="search" class="form-control form-control-sm" placeholder="e.g. STAR/2026/0001 or Aarav" value="<%= search || '' %>">
                            </div>
                            <div class="col-md-3">
                                <label class="small text-muted fw-semibold">From Date</label>
                                <input type="date" name="from_date" class="form-control form-control-sm" value="<%= from_date || '' %>">
                            </div>
                            <div class="col-md-3">
                                <label class="small text-muted fw-semibold">To Date</label>
                                <input type="date" name="to_date" class="form-control form-control-sm" value="<%= to_date || '' %>">
                            </div>
                            <div class="col-md-2 d-flex gap-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">Search</button>
                                <a href="/admin/receipts" class="btn btn-sm btn-outline-secondary">Reset</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Receipts Table -->
                <div class="admin-card">
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Receipt No</th>
                                    <th>Date</th>
                                    <th>Adm No</th>
                                    <th>Student Name</th>
                                    <th>Class & Sec</th>
                                    <th>Amount Paid (₹)</th>
                                    <th>Payment Mode</th>
                                    <th>Cashier</th>
                                    <th class="text-end">Print Slip</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (receipts && receipts.length > 0) { %>
                                    <% receipts.forEach(r => { %>
                                        <tr>
                                            <td><strong class="text-primary"><%= r.receipt_no %></strong></td>
                                            <td><%= new Date(r.payment_date).toLocaleDateString('en-IN') %></td>
                                            <td><small class="text-muted"><%= r.admission_no %></small></td>
                                            <td>
                                                <a href="/admin/students/<%= r.student_id %>" class="fw-bold text-dark text-decoration-none">
                                                    <%= r.first_name %> <%= r.last_name %>
                                                </a>
                                            </td>
                                            <td><span class="badge bg-light text-dark border"><%= r.class_name %>-<%= r.section_name %></span></td>
                                            <td><strong class="text-success fs-6">₹<%= Number(r.amount_paid).toLocaleString('en-IN') %></strong></td>
                                            <td><span class="badge bg-secondary-subtle text-dark"><%= r.payment_mode %></span></td>
                                            <td><small class="text-muted"><%= r.cashier_name || 'Admin' %></small></td>
                                            <td class="text-end">
                                                <a href="/admin/receipts/<%= r.id %>/print" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-3 fw-semibold">
                                                    <i class="fa-solid fa-print me-1"></i> Print Slip
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="9" class="text-center text-muted py-5">No payment receipts found matching your criteria.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
