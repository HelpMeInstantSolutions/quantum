<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="fa-solid fa-chalkboard-user text-primary me-2"></i>Teachers & Academic Faculty</h4>
                        <p class="text-muted small mb-0">Manage teaching staff accounts, edit details, reset app passwords, assign Class Teacher roles and subject permissions.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/admin/classes#tab-allocations" class="btn btn-outline-secondary btn-sm fw-semibold">
                            <i class="fa-solid fa-sliders me-1"></i> Subject Allocations
                        </a>
                        <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addTeacherModal">
                            <i class="fa-solid fa-user-plus me-1"></i> Register Faculty
                        </button>
                    </div>
                </div>

                <!-- Teachers Table -->
                <div class="admin-card">
                    <div class="admin-card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">Faculty Members Directory</h5>
                        <span class="badge bg-primary"><%= teachers.length %> Registered Faculty</span>
                    </div>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Faculty Name & Designation</th>
                                    <th>App Username</th>
                                    <th>Contact Phone</th>
                                    <th>Class Teacher Role</th>
                                    <th>Assigned Subjects</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (teachers && teachers.length > 0) { %>
                                    <% teachers.forEach(t => { %>
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-primary border"><%= t.employee_code || 'EMP-AUTO' %></span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="<%= getAvatar(t.avatar_url, t.gender, 'teacher') %>" class="rounded-circle border" style="width: 36px; height: 36px; object-fit: cover;">
                                                    <div>
                                                        <div class="fw-bold text-dark"><%= t.name %></div>
                                                        <small class="text-muted"><%= t.designation %> (<%= t.qualification || 'Faculty' %>) &bull; <span class="badge bg-light text-secondary border"><%= t.gender || 'Male' %></span></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><code><%= t.username %></code></td>
                                            <td>
                                                <% if (t.phone) { %>
                                                    <a href="tel:<%= t.phone %>" class="text-muted small"><i class="fa-solid fa-phone text-success me-1"></i><%= t.phone %></a>
                                                <% } else { %>
                                                    <span class="text-muted small">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (t.class_teacher_of) { %>
                                                    <span class="badge bg-success-subtle text-success border">
                                                        <i class="fa-solid fa-shield-halved me-1"></i> Class Teacher (<%= t.class_teacher_of %>-<%= t.class_teacher_sec %>)
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-muted small">Subject Teacher</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (t.allocated_subjects && t.allocated_subjects.length > 0) { %>
                                                    <% t.allocated_subjects.forEach(asub => { %>
                                                        <span class="badge bg-primary-subtle text-primary border mb-1">
                                                            <%= asub.subject_name %> (<%= asub.class_name %>-<%= asub.section_name %>)
                                                        </span>
                                                    <% }) %>
                                                <% } else { %>
                                                    <span class="text-muted small">No subjects assigned yet</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <!-- Edit Teacher Button -->
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 me-1" data-bs-toggle="modal" data-bs-target="#editTeacherModal<%= t.id %>" title="Edit Faculty Details">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>

                                                <!-- Change Password Button -->
                                                <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 me-1" data-bs-toggle="modal" data-bs-target="#changePassModal<%= t.id %>" title="Change Android App Password">
                                                    <i class="fa-solid fa-key"></i>
                                                </button>

                                                <!-- Delete Button -->
                                                <form action="/admin/teachers/<%= t.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove teacher <%= t.name %>?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Remove Faculty">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                        <!-- MODAL: Change Password for this Teacher -->
                                        <div class="modal fade" id="changePassModal<%= t.id %>" tabindex="-1">
                                            <div class="modal-dialog modal-sm">
                                                <div class="modal-content text-start">
                                                    <form action="/admin/teachers/<%= t.id %>/change-password" method="POST">
                                                        <div class="modal-header">
                                                            <h6 class="modal-title fw-bold"><i class="fa-solid fa-key text-warning me-2"></i>Change Password</h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-2">
                                                                <small class="text-muted d-block">Faculty Member:</small>
                                                                <strong class="text-dark"><%= t.name %></strong>
                                                            </div>
                                                            <div class="mb-3">
                                                                <small class="text-muted d-block">App Username:</small>
                                                                <code><%= t.username %></code>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold">New App Password *</label>
                                                                <input type="text" name="new_password" id="passInput<%= t.id %>" class="form-control form-control-sm fw-bold" required minlength="4" value="teacher123">
                                                            </div>
                                                            <div class="d-flex gap-1 mb-2">
                                                                <button type="button" class="btn btn-xs btn-outline-secondary small" style="font-size: 0.72rem;" onclick="document.getElementById('passInput<%= t.id %>').value='teacher123';">Default (teacher123)</button>
                                                                <button type="button" class="btn btn-xs btn-outline-secondary small" style="font-size: 0.72rem;" onclick="document.getElementById('passInput<%= t.id %>').value='123456';">123456</button>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-warning fw-bold">Update Password</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- MODAL: Edit Teacher Details -->
                                        <div class="modal fade" id="editTeacherModal<%= t.id %>" tabindex="-1">
                                            <div class="modal-dialog modal-lg text-start">
                                                <div class="modal-content">
                                                    <form action="/admin/teachers/<%= t.id %>/edit" method="POST">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Faculty Member - <%= t.name %></h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="row g-3">
                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Full Name *</label>
                                                                    <input type="text" name="name" class="form-control form-control-sm" required value="<%= t.name %>">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Gender *</label>
                                                                    <select name="gender" class="form-select form-select-sm" required>
                                                                        <option value="Male" <%= t.gender === 'Male' ? 'selected' : '' %>>Male (Default Male Avatar)</option>
                                                                        <option value="Female" <%= t.gender === 'Female' ? 'selected' : '' %>>Female (Default Female Avatar)</option>
                                                                    </select>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Employee Code</label>
                                                                    <input type="text" name="employee_code" class="form-control form-control-sm" value="<%= t.employee_code || '' %>" placeholder="e.g. EMP-103">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">App Login Username *</label>
                                                                    <input type="text" name="username" class="form-control form-control-sm" required value="<%= t.username %>">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Designation</label>
                                                                    <input type="text" name="designation" class="form-control form-control-sm" value="<%= t.designation || '' %>" placeholder="e.g. Senior Faculty - Physics">
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Qualification</label>
                                                                    <input type="text" name="qualification" class="form-control form-control-sm" value="<%= t.qualification || '' %>" placeholder="e.g. M.Sc, B.Ed">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Phone Number</label>
                                                                    <input type="tel" name="phone" class="form-control form-control-sm" value="<%= t.phone || '' %>" placeholder="+91-9812XXXXXX">
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Email</label>
                                                                    <input type="email" name="email" class="form-control form-control-sm" value="<%= t.email || '' %>" placeholder="teacher@quantumscience.in">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label small fw-bold">Monthly Salary (₹)</label>
                                                                    <input type="number" step="100" name="salary" class="form-control form-control-sm" value="<%= t.salary || '' %>" placeholder="e.g. 35000">
                                                                </div>

                                                                <!-- Class Teacher Designation -->
                                                                <div class="col-12 border-top pt-2 mt-2">
                                                                    <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-crown me-1"></i>Class Teacher Designation</h6>
                                                                    <small class="text-muted d-block mb-2">Class teachers can mark daily attendance for their assigned class & section.</small>
                                                                    <div class="row g-2">
                                                                        <div class="col-6">
                                                                            <label class="form-label small">Assigned Class</label>
                                                                            <select name="assigned_class_id" class="form-select form-select-sm edit-assigned-class" data-target="editSectionSelect<%= t.id %>">
                                                                                <option value="">Not a Class Teacher (Subject Teacher Only)</option>
                                                                                <% classes.forEach(c => { %>
                                                                                    <option value="<%= c.id %>" <%= t.assigned_class_id == c.id ? 'selected' : '' %>><%= c.class_name %></option>
                                                                                <% }) %>
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-6">
                                                                            <label class="form-label small">Assigned Section</label>
                                                                            <select name="assigned_section_id" id="editSectionSelect<%= t.id %>" class="form-select form-select-sm">
                                                                                <% if (!t.assigned_class_id) { %>
                                                                                    <option value="">-- Select Class First --</option>
                                                                                <% } else { %>
                                                                                    <option value="">-- Choose Section --</option>
                                                                                    <% sections.filter(s => s.class_id == t.assigned_class_id).forEach(s => { %>
                                                                                        <option value="<%= s.id %>" <%= t.assigned_section_id == s.id ? 'selected' : '' %>>Section <%= s.section_name %></option>
                                                                                    <% }) %>
                                                                                <% } %>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary fw-bold">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="7" class="text-center text-muted py-5">No faculty members found. Click "Register Faculty" to add one.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Modal: Register Faculty -->
                <div class="modal fade" id="addTeacherModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <form action="/admin/teachers/create" method="POST">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus text-primary me-2"></i>Register Faculty Member</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Full Name *</label>
                                            <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. Ramesh Sharma">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Gender *</label>
                                            <select name="gender" class="form-select form-select-sm" required>
                                                <option value="Male">Male (Default Male Avatar)</option>
                                                <option value="Female">Female (Default Female Avatar)</option>
                                            </select>
                                        </div>
                                        
                                        <!-- Employee Code Optional -->
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Employee Code <span class="text-muted fw-normal">(Optional)</span></label>
                                            <input type="text" name="employee_code" class="form-control form-control-sm" placeholder="e.g. EMP-103 (Leave empty to auto-generate)">
                                            <div class="form-text">If left empty, system will auto-assign a unique employee code.</div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">App Login Username *</label>
                                            <input type="text" name="username" class="form-control form-control-sm" required placeholder="e.g. ramesh.sharma">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">App Login Password *</label>
                                            <input type="text" name="password" class="form-control form-control-sm fw-bold" required value="teacher123">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Designation</label>
                                            <input type="text" name="designation" class="form-control form-control-sm" placeholder="e.g. Senior Faculty - Physics">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Qualification</label>
                                            <input type="text" name="qualification" class="form-control form-control-sm" placeholder="e.g. M.Sc, B.Ed">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Phone Number</label>
                                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+91-9812XXXXXX">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Email</label>
                                            <input type="email" name="email" class="form-control form-control-sm" placeholder="teacher@quantumscience.in">
                                        </div>

                                        <!-- Class Teacher Designation -->
                                        <div class="col-12 border-top pt-2 mt-3">
                                            <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-crown me-1"></i>Class Teacher Designation (Elevated App Permissions)</h6>
                                            <small class="text-muted d-block mb-2">Class teachers can mark daily attendance for their assigned class & section and send class-specific alerts.</small>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <label class="form-label small">Assigned Class</label>
                                                    <select name="assigned_class_id" id="assignedClassSelect" class="form-select form-select-sm">
                                                        <option value="">Not a Class Teacher (Subject Teacher Only)</option>
                                                        <% classes.forEach(c => { %>
                                                            <option value="<%= c.id %>"><%= c.class_name %></option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small">Assigned Section</label>
                                                    <select name="assigned_section_id" id="assignedSectionSelect" class="form-select form-select-sm">
                                                        <option value="">-- Select Class First --</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary fw-bold">Register Faculty</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script>
        const allSections = <%- JSON.stringify(sections) %>;
        const assignedClass = document.getElementById('assignedClassSelect');
        const assignedSection = document.getElementById('assignedSectionSelect');

        function updateSectionDropdown(classId, sectionSelectElem, preselectedSectionId) {
            if (!sectionSelectElem) return;
            sectionSelectElem.innerHTML = '<option value="">-- Choose Section --</option>';
            if (classId) {
                const filtered = allSections.filter(s => String(s.class_id) === String(classId));
                filtered.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `Section ${s.section_name}`;
                    if (preselectedSectionId && String(s.id) === String(preselectedSectionId)) {
                        opt.selected = true;
                    }
                    sectionSelectElem.appendChild(opt);
                });
            } else {
                sectionSelectElem.innerHTML = '<option value="">-- Select Class First --</option>';
            }
        }

        if (assignedClass && assignedSection) {
            assignedClass.addEventListener('change', function() {
                updateSectionDropdown(this.value, assignedSection, null);
            });
        }

        // Handlers for Edit Teacher modals
        document.querySelectorAll('.edit-assigned-class').forEach(sel => {
            sel.addEventListener('change', function() {
                const targetId = this.getAttribute('data-target');
                const secElem = document.getElementById(targetId);
                updateSectionDropdown(this.value, secElem, null);
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
