<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-wrapper">
        <%- include('../../partials/admin_sidebar') %>

        <div class="admin-main">
            <%- include('../../partials/admin_header') %>

            <main class="admin-content">
                <%- include('../../partials/alerts') %>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">
                            <%= isMarkMode ? '✏️ Daily Class Attendance Marker' : '📋 Master Attendance Logs' %>
                        </h4>
                        <p class="text-muted small mb-0">
                            <%= isMarkMode ? 'Select class & section to manually record attendance.' : 'Live attendance records in descending order with School (Morning) & Tuition (Evening) In/Out timestamps.' %>
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-2 mt-sm-0">
                        <% if (isMarkMode) { %>
                            <a href="/admin/attendance" class="btn btn-outline-primary btn-sm fw-semibold">
                                <i class="fa-solid fa-list-check me-1"></i> View All Logs (Descending)
                            </a>
                        <% } else { %>
                            <a href="/admin/attendance?mode=mark" class="btn btn-primary btn-sm fw-semibold shadow-sm">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Mark Class Attendance Sheet
                            </a>
                        <% } %>
                        <a href="/admin/attendance/report" class="btn btn-outline-secondary btn-sm fw-semibold">
                            <i class="fa-solid fa-chart-line me-1"></i> Monthly Register
                        </a>
                    </div>
                </div>

                <% if (isMarkMode) { %>
                    <!-- ========================================================= -->
                    <!-- MODE 1: MARK CLASS ATTENDANCE SHEET -->
                    <!-- ========================================================= -->
                    <div class="admin-card mb-4">
                        <div class="admin-card-body p-3">
                            <form method="GET" action="/admin/attendance" class="row g-2 align-items-end">
                                <input type="hidden" name="mode" value="mark">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Select Class *</label>
                                    <select name="class_id" id="attendanceClassSelect" class="form-select form-select-sm" required>
                                        <% classes.forEach(c => { %>
                                            <option value="<%= c.id %>" <%= class_id == c.id ? 'selected' : '' %>><%= c.class_name %> (<%= c.student_count || 0 %> Students)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Select Section *</label>
                                    <select name="section_id" id="attendanceSectionSelect" class="form-select form-select-sm" required>
                                        <% (classSections && classSections.length > 0 ? classSections : sections.filter(s => s.class_id == class_id)).forEach(s => { %>
                                            <option value="<%= s.id %>" <%= section_id == s.id ? 'selected' : '' %>>Section <%= s.section_name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Attendance Date *</label>
                                    <input type="date" name="date" class="form-control form-control-sm" value="<%= attendance_date || new Date().toISOString().split('T')[0] %>" required>
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">
                                        <i class="fa-solid fa-users-viewfinder me-1"></i> Load Students
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <% if (students && students.length > 0) { %>
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 bg-white rounded-3 border">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark"><%= selectedClass?.class_name %> - Section <%= selectedSection?.section_name %></span>
                                <span class="badge bg-secondary-subtle text-dark border"><%= students.length %> Enrolled</span>
                                <span class="text-muted small">| Date: <strong><%= attendance_date || new Date().toISOString().split('T')[0] %></strong></span>
                            </div>
                            <div class="d-flex gap-2 mt-2 mt-sm-0">
                                <button type="button" class="btn btn-sm btn-outline-success fw-bold" onclick="markAll('Present')">
                                    <i class="fa-solid fa-check-double me-1"></i> Mark All Present
                                </button>
                                <form action="/admin/attendance/send-absent-alert" method="POST" class="d-inline" onsubmit="return confirm('Dispatch instant absent notifications to all parents of absent students for this date?');">
                                    <input type="hidden" name="class_id" value="<%= class_id %>">
                                    <input type="hidden" name="section_id" value="<%= section_id %>">
                                    <input type="hidden" name="attendance_date" value="<%= attendance_date || new Date().toISOString().split('T')[0] %>">
                                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold">
                                        <i class="fa-solid fa-bell me-1"></i> Dispatch Absent Alerts
                                    </button>
                                </form>
                            </div>
                        </div>

                        <form action="/admin/attendance/save" method="POST">
                            <input type="hidden" name="class_id" value="<%= class_id %>">
                            <input type="hidden" name="section_id" value="<%= section_id %>">
                            <input type="hidden" name="attendance_date" value="<%= attendance_date || new Date().toISOString().split('T')[0] %>">

                            <div class="admin-card">
                                <div class="table-responsive">
                                    <table class="admin-table align-middle">
                                        <thead>
                                            <tr>
                                                <th style="width: 70px;">Roll</th>
                                                <th>Student Info</th>
                                                <th class="text-center" style="width: 170px;">
                                                    <i class="fa-solid fa-school text-primary me-1"></i> School Session<br>
                                                    <small class="text-muted fw-normal" style="font-size: 0.7rem;">(Morning IN - OUT)</small>
                                                </th>
                                                <th class="text-center" style="width: 170px;">
                                                    <i class="fa-solid fa-book-open-reader text-warning me-1"></i> Tuition Session<br>
                                                    <small class="text-muted fw-normal" style="font-size: 0.7rem;">(Evening IN - OUT)</small>
                                                </th>
                                                <th style="width: 290px;" class="text-center">Daily Status</th>
                                                <th>Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% students.forEach((st, idx) => { %>
                                                <% const currentStatus = st.attendance_status || 'Present'; %>
                                                <tr>
                                                    <td><strong><%= st.roll_no || (idx + 1) %></strong></td>
                                                    <td>
                                                        <span class="fw-bold text-dark d-block"><%= st.first_name %> <%= st.last_name %></span>
                                                        <div class="d-flex align-items-center gap-1 mt-1">
                                                            <small class="text-muted"><%= st.admission_no %></small>
                                                            <% if (st.biometric_id) { %>
                                                                <span class="badge bg-primary text-white border-0 p-0 px-1 font-monospace" style="font-size: 0.7rem;" title="Biometric Machine ID"><i class="fa-solid fa-fingerprint me-1"></i>Bio: <%= st.biometric_id %></span>
                                                            <% } else { %>
                                                                <span class="badge bg-light text-muted border p-0 px-1 font-monospace" style="font-size: 0.7rem;" title="No Biometric ID Assigned"><i class="fa-solid fa-fingerprint me-1"></i>Bio: --</span>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (st.morning_in) { %>
                                                            <div class="small fw-bold text-success"><i class="fa-solid fa-arrow-right-to-bracket text-success me-1"></i>IN: <%= st.morning_in.slice(0, 5) %></div>
                                                            <div class="small text-secondary"><i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i>OUT: <%= st.morning_out ? st.morning_out.slice(0, 5) : '--:--' %></div>
                                                        <% } else { %>
                                                            <span class="text-muted small">-- : --</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (st.tuition_in) { %>
                                                            <div class="small fw-bold text-warning-emphasis"><i class="fa-solid fa-arrow-right-to-bracket text-warning me-1"></i>IN: <%= st.tuition_in.slice(0, 5) %></div>
                                                            <div class="small text-secondary"><i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i>OUT: <%= st.tuition_out ? st.tuition_out.slice(0, 5) : '--:--' %></div>
                                                        <% } else { %>
                                                            <span class="text-muted small">-- : --</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <input type="radio" class="btn-check" name="attendance[<%= st.id %>]" id="pres_<%= st.id %>" value="Present" <%= currentStatus === 'Present' ? 'checked' : '' %>>
                                                            <label class="btn btn-outline-success fw-semibold" for="pres_<%= st.id %>">Present</label>

                                                            <input type="radio" class="btn-check" name="attendance[<%= st.id %>]" id="abs_<%= st.id %>" value="Absent" <%= currentStatus === 'Absent' ? 'checked' : '' %>>
                                                            <label class="btn btn-outline-danger fw-semibold" for="abs_<%= st.id %>">Absent</label>

                                                            <input type="radio" class="btn-check" name="attendance[<%= st.id %>]" id="late_<%= st.id %>" value="Late" <%= currentStatus === 'Late' ? 'checked' : '' %>>
                                                            <label class="btn btn-outline-warning text-dark fw-semibold" for="late_<%= st.id %>">Late</label>

                                                            <input type="radio" class="btn-check" name="attendance[<%= st.id %>]" id="half_<%= st.id %>" value="Half Day" <%= currentStatus === 'Half Day' ? 'checked' : '' %>>
                                                            <label class="btn btn-outline-info text-dark fw-semibold" for="half_<%= st.id %>">Half Day</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="remarks[<%= st.id %>]" class="form-control form-control-sm" placeholder="e.g. Leave request" value="<%= st.remarks || '' %>">
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="admin-card-body border-top d-flex justify-content-end bg-light">
                                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                        <i class="fa-solid fa-save me-1"></i> Save Daily Attendance
                                    </button>
                                </div>
                            </div>
                        </form>
                    <% } else { %>
                        <div class="admin-card p-5 text-center text-muted">
                            <i class="fa-solid fa-user-group fs-1 text-secondary mb-3"></i>
                            <h5>No enrolled students found in this Class & Section.</h5>
                            <p class="small text-muted mb-0">Please select a class that has enrolled students from the dropdown above (e.g. classes showing active student count) and click <strong>Load Students</strong>.</p>
                        </div>
                    <% } %>

                <% } else { %>
                    <!-- ========================================================= -->
                    <!-- MODE 2 (DEFAULT): ALL ATTENDANCE LOGS IN DESCENDING ORDER -->
                    <!-- ========================================================= -->

                    <!-- Filter & Search Toolbar -->
                    <div class="admin-card mb-4">
                        <div class="admin-card-body p-3">
                            <form method="GET" action="/admin/attendance" class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Search Student</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass"></i></span>
                                        <input type="text" name="search" class="form-control form-control-sm" placeholder="Name / Adm No / Bio ID" value="<%= search %>">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-muted">Date</label>
                                    <input type="date" name="date" class="form-control form-control-sm" value="<%= attendance_date %>">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-muted">Class</label>
                                    <select name="class_id" class="form-select form-select-sm">
                                        <option value="">All Classes</option>
                                        <% classes.forEach(c => { %>
                                            <option value="<%= c.id %>" <%= class_id == c.id ? 'selected' : '' %>><%= c.class_name %> (<%= c.student_count || 0 %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">
                                        <i class="fa-solid fa-filter me-1"></i> Filter
                                    </button>
                                    <a href="/admin/attendance" class="btn btn-sm btn-outline-secondary px-3" title="Clear Filters">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </a>
                                </div>
                                <div class="col-md-2 text-end">
                                    <span class="badge bg-secondary-subtle text-dark border p-2 w-100">
                                        Total Records: <strong><%= totalRecords %></strong>
                                    </span>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Master Table -->
                    <div class="admin-card">
                        <div class="table-responsive">
                            <table class="admin-table align-middle">
                                <thead>
                                    <tr>
                                        <th style="width: 105px;">Date</th>
                                        <th style="width: 75px;">Roll</th>
                                        <th>Student Details</th>
                                        <th style="width: 130px;">Class &amp; Sec</th>
                                        <th class="text-center" style="width: 180px;">
                                            <i class="fa-solid fa-school text-primary me-1"></i> School (Morning)<br>
                                            <small class="text-muted fw-normal" style="font-size: 0.72rem;">(IN - OUT)</small>
                                        </th>
                                        <th class="text-center" style="width: 180px;">
                                            <i class="fa-solid fa-book-open-reader text-warning me-1"></i> Tuition (Evening)<br>
                                            <small class="text-muted fw-normal" style="font-size: 0.72rem;">(IN - OUT)</small>
                                        </th>
                                        <th class="text-center" style="width: 110px;">Status</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (allAttendanceLogs && allAttendanceLogs.length > 0) { %>
                                        <% allAttendanceLogs.forEach(row => { %>
                                            <tr>
                                                <td class="font-monospace fw-semibold text-dark text-nowrap">
                                                    <%= row.attendance_date %>
                                                </td>
                                                <td><strong><%= row.roll_no || '-' %></strong></td>
                                                <td>
                                                    <span class="fw-bold text-dark d-block"><%= row.first_name %> <%= row.last_name %></span>
                                                    <div class="d-flex align-items-center gap-1 mt-1">
                                                        <small class="text-muted"><%= row.admission_no %></small>
                                                        <% if (row.biometric_id) { %>
                                                            <span class="badge bg-primary text-white border-0 font-monospace p-0 px-1" style="font-size: 0.7rem;" title="Biometric Machine User ID"><i class="fa-solid fa-fingerprint me-1"></i>Bio: <%= row.biometric_id %></span>
                                                        <% } else { %>
                                                            <span class="badge bg-light text-muted border font-monospace p-0 px-1" style="font-size: 0.7rem;" title="No Biometric ID Assigned"><i class="fa-solid fa-fingerprint me-1"></i>Bio: --</span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary border"><%= row.class_name %> - <%= row.section_name %></span>
                                                </td>
                                                <td class="text-center">
                                                    <% if (row.morning_in) { %>
                                                        <div class="small fw-bold text-success"><i class="fa-solid fa-arrow-right-to-bracket text-success me-1"></i>IN: <%= row.morning_in.slice(0, 5) %></div>
                                                        <div class="small text-secondary"><i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i>OUT: <%= row.morning_out ? row.morning_out.slice(0, 5) : '--:--' %></div>
                                                    <% } else { %>
                                                        <span class="text-muted small">-- : --</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <% if (row.tuition_in) { %>
                                                        <div class="small fw-bold text-warning-emphasis"><i class="fa-solid fa-arrow-right-to-bracket text-warning me-1"></i>IN: <%= row.tuition_in.slice(0, 5) %></div>
                                                        <div class="small text-secondary"><i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i>OUT: <%= row.tuition_out ? row.tuition_out.slice(0, 5) : '--:--' %></div>
                                                    <% } else { %>
                                                        <span class="text-muted small">-- : --</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <% if (row.attendance_status === 'Present') { %>
                                                        <span class="badge bg-success-subtle text-success border px-2 py-1">Present</span>
                                                    <% } else if (row.attendance_status === 'Absent') { %>
                                                        <span class="badge bg-danger-subtle text-danger border px-2 py-1">Absent</span>
                                                    <% } else if (row.attendance_status === 'Late') { %>
                                                        <span class="badge bg-warning-subtle text-warning border px-2 py-1">Late</span>
                                                    <% } else { %>
                                                        <span class="badge bg-info-subtle text-info border px-2 py-1"><%= row.attendance_status %></span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <small class="text-muted"><%= row.remarks || '-' %></small>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-5">
                                                <i class="fa-solid fa-clipboard-question fs-2 mb-2 d-block"></i>
                                                No attendance records found matching current criteria.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Footer -->
                        <% if (totalPages > 1) { %>
                            <div class="admin-card-body border-top d-flex flex-wrap justify-content-between align-items-center py-2 px-3 bg-light">
                                <small class="text-muted">
                                    Showing page <strong><%= page %></strong> of <strong><%= totalPages %></strong> (<%= totalRecords %> total entries)
                                </small>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <!-- Previous -->
                                        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="/admin/attendance?page=<%= page - 1 %>&date=<%= attendance_date %>&class_id=<%= class_id || '' %>&search=<%= search %>">
                                                <i class="fa-solid fa-chevron-left"></i>
                                            </a>
                                        </li>

                                        <!-- Page Numbers -->
                                        <% 
                                            const startPage = Math.max(1, page - 2);
                                            const endPage = Math.min(totalPages, page + 2);
                                            for (let p = startPage; p <= endPage; p++) { 
                                        %>
                                            <li class="page-item <%= p === page ? 'active' : '' %>">
                                                <a class="page-link" href="/admin/attendance?page=<%= p %>&date=<%= attendance_date %>&class_id=<%= class_id || '' %>&search=<%= search %>">
                                                    <%= p %>
                                                </a>
                                            </li>
                                        <% } %>

                                        <!-- Next -->
                                        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="/admin/attendance?page=<%= page + 1 %>&date=<%= attendance_date %>&class_id=<%= class_id || '' %>&search=<%= search %>">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        <% } %>
                    </div>
                <% } %>

            </main>
        </div>
    </div>

    <script>
        const allSections = <%- JSON.stringify(sections) %>;
        const classSelect = document.getElementById('attendanceClassSelect');
        const sectionSelect = document.getElementById('attendanceSectionSelect');

        function updateSectionsForClass(classId) {
            if (!sectionSelect) return;
            sectionSelect.innerHTML = '';
            const filtered = allSections.filter(s => String(s.class_id) === String(classId));
            if (filtered.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'No sections available';
                sectionSelect.appendChild(opt);
                return;
            }
            filtered.forEach((s, idx) => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = `Section ${s.section_name}`;
                if (idx === 0) opt.selected = true;
                sectionSelect.appendChild(opt);
            });
        }

        if (classSelect && sectionSelect) {
            classSelect.addEventListener('change', function() {
                updateSectionsForClass(this.value);
            });
        }

        function markAll(status) {
            if (status === 'Present') {
                document.querySelectorAll('input[type="radio"][value="Present"]').forEach(r => r.checked = true);
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
